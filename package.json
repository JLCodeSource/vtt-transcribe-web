{
  "name": "vtt-transcribe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless in-browser audio transcription: bring your own OpenAI key, or run Whisper on your own device.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte-check": "^4.4.6",
    "tslib": "^2.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
